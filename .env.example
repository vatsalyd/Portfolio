# Mini Vatsal agent — OpenAI-compatible chat endpoint.
# Leave VITE_LLM_API_KEY blank to use the built-in pattern-matched fallback.
# Works with OpenAI, Groq (VITE_LLM_BASE_URL=https://api.groq.com/openai/v1),
# OpenRouter, and any OpenAI-compatible provider.
VITE_LLM_API_KEY=
VITE_LLM_BASE_URL=https://api.openai.com/v1
VITE_LLM_MODEL=gpt-4o-mini
